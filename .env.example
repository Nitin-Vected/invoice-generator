# Used by docker-compose.yml. Copy to `.env` and adjust:  cp .env.example .env
# The values below are local-development placeholders, not real credentials.

# Host ports
WEB_HOST_PORT=8080
API_HOST_PORT=3000
DB_HOST_PORT=5432

# Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=simple_invoice

# Origins allowed to call the API directly (the web app itself goes through nginx)
CORS_ORIGIN=http://localhost:8080

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=3600

# Reviewer account created by the seed on startup
SEED_USER_EMAIL=admin@simpleinvoice.dev
SEED_USER_PASSWORD=Admin@123
SEED_USER_FULLNAME=Admin User
